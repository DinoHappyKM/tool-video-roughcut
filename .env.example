# ==============================================================================
# DinoHappyKM: AI Video Rough-Cut - Local Environment Configuration
# Copy this file to `.env` and adjust the paths to your local SSD / External Drive
# ==============================================================================

# [Windows Example]
# MEDIA_ROOT=E:/DinoHappyKM_Media
# A_ROLL_DIR=E:/DinoHappyKM_Media/a_roll
# B_ROLL_DIR=E:/DinoHappyKM_Media/b_roll

# [macOS Example]
# MEDIA_ROOT=/Volumes/Extreme_SSD/DinoHappyKM_Media
# A_ROLL_DIR=/Volumes/Extreme_SSD/DinoHappyKM_Media/a_roll
# B_ROLL_DIR=/Volumes/Extreme_SSD/DinoHappyKM_Media/b_roll

# Default relative paths (falls back to local assets if MEDIA_ROOT is not set)
MEDIA_ROOT=
A_ROLL_DIR=
B_ROLL_DIR=
OUTPUT_DIR=./output
