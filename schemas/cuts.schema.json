{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinohappykm.local/schemas/cuts.schema.json",
  "title": "AI Video Engine Cuts",
  "type": "object",
  "required": ["schema_version", "project_id", "output_id", "topic_id", "human_approval", "cuts"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {"type": "string"},
    "output_id": {"type": "string"},
    "topic_id": {"type": "string"},
    "human_approval": {
      "type": "object",
      "required": ["status", "approved_at"],
      "properties": {
        "status": {"const": "approved"},
        "approved_at": {"type": "string"}
      }
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cut_id", "media_id", "source_start", "source_end", "timeline_start", "timeline_end", "source_segments"],
        "properties": {
          "cut_id": {"type": "string"},
          "media_id": {"type": "string"},
          "source_start": {"type": "number", "minimum": 0},
          "source_end": {"type": "number", "exclusiveMinimum": 0},
          "timeline_start": {"type": "number", "minimum": 0},
          "timeline_end": {"type": "number", "exclusiveMinimum": 0},
          "source_segments": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
