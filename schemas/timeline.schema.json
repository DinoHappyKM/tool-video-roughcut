{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinohappykm.local/schemas/timeline.schema.json",
  "title": "AI Video Engine Timeline",
  "type": "object",
  "required": ["schema_version", "project_id", "output_id", "topic_id", "sequence", "tracks", "duration_seconds"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "project_id": {"type": "string", "minLength": 1},
    "output_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "sequence": {
      "type": "object",
      "required": ["name", "fps", "width", "height"],
      "properties": {
        "name": {"type": "string"},
        "fps": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "tracks": {
      "type": "object",
      "required": ["video", "audio"],
      "properties": {
        "video": {"$ref": "#/$defs/tracks"},
        "audio": {"$ref": "#/$defs/tracks"}
      }
    }
  },
  "$defs": {
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["track_id", "role", "items"],
        "properties": {
          "track_id": {"type": "string"},
          "role": {"type": "string"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/clip"}
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "required": ["clip_id", "media_id", "source_start", "source_end", "timeline_start", "timeline_end"],
      "properties": {
        "clip_id": {"type": "string"},
        "media_id": {"type": "string"},
        "source_start": {"type": "number", "minimum": 0},
        "source_end": {"type": "number", "exclusiveMinimum": 0},
        "timeline_start": {"type": "number", "minimum": 0},
        "timeline_end": {"type": "number", "exclusiveMinimum": 0},
        "transcript_text": {"type": "string"},
        "needs_manual_review": {"type": "boolean"}
      }
    }
  }
}
